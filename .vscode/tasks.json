{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev (backend + ngrok)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/start_dev.ps1",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sync ngrok URL",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/sync_ngrok.ps1",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Install backend deps",
      "type": "shell",
      "command": "cd backend && pip install -r requirements.txt",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
